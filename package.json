{
  "name": "Raven",
  "private": true,
  "version": "0.0.1",
  "description": "Raven — a statically typed language for the JavaScript ecosystem that compiles to optimized JS.",
  "license": "MIT",
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "build": "pnpm run build:compiler && pnpm run build:language-server && pnpm run build:extension",
    "build:compiler": "pnpm --filter @raven/compiler run build",
    "build:language-server": "pnpm --filter @raven/language-server run build",
    "build:extension": "pnpm --filter raven-language run build",
    "dev": "pnpm --filter @raven/compiler run dev",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "clean": "pnpm -r run clean",
    "package": "pnpm run build && pnpm --filter raven-language run package",
    "bench": "node --import tsx benchmarks/run.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.7",
    "@types/node": "^20.14.10",
    "eslint": "^9.8.0",
    "tsup": "^8.2.4",
    "tsx": "^4.23.13",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
