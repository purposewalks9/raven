{
  "displayName": "Raven",
  "name": "raven",
  "scopeName": "source.raven",
  "fileTypes": ["rv"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#booleans" },
    { "include": "#control-keywords" },
    { "include": "#declaration-keywords" },
    { "include": "#logical-word-operators" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.raven",
          "begin": "//",
          "end": "$",
          "captures": { "0": { "name": "punctuation.definition.comment.raven" } }
        },
        {
          "name": "comment.block.raven",
          "begin": "/\\*",
          "end": "\\*/",
          "captures": { "0": { "name": "punctuation.definition.comment.raven" } }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.raven",
          "begin": "\"",
          "end": "\"",
          "captures": { "0": { "name": "punctuation.definition.string.raven" } },
          "patterns": [
            { "name": "constant.character.escape.raven", "match": "\\\\[\\\\\"nrt]" }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.float.raven", "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b" },
        { "name": "constant.numeric.integer.raven", "match": "\\b[0-9]+\\b" }
      ]
    },
    "booleans": {
      "patterns": [
        { "name": "constant.language.boolean.raven", "match": "\\b(true|false)\\b" }
      ]
    },
    "control-keywords": {
      "patterns": [
        { "name": "keyword.control.raven", "match": "\\b(if|then|else|end|while|do|break|continue|return|print)\\b" }
      ]
    },
    "declaration-keywords": {
      "patterns": [
        { "name": "storage.type.raven", "match": "\\b(let|const|fn|model)\\b" },
        { "name": "keyword.control.import.raven", "match": "\\b(import|from)\\b" }
      ]
    },
    "logical-word-operators": {
      "patterns": [
        { "name": "keyword.operator.word.raven", "match": "\\b(and|or|not)\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "support.type.primitive.raven", "match": "\\b(string|number|boolean|any|array)\\b" },
        { "name": "entity.name.type.raven", "match": "\\b[A-Z][a-zA-Z0-9]*\\b" }
      ]
    },
    "functions": {
      "patterns": [
        { "name": "entity.name.function.raven", "match": "[a-z_][a-zA-Z0-9_]*(?=\\s*\\()" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.raven", "match": "(\\+|-|\\*|/|%|==|!=|<=|>=|<|>|=)" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.raven", "match": "[{}\\(\\)\\[\\];:,.]" }
      ]
    }
  }
}