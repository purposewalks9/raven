{
  "Function Declaration": {
    "prefix": "fn",
    "body": ["fn ${1:functionName}(${2:params}) ${3:-> ReturnType} {", "\t$0", "}"],
    "description": "Declare a new function"
  },
  "If Statement": {
    "prefix": "if",
    "body": ["if ${1:condition} {", "\t$0", "}"],
    "description": "If statement"
  },
  "If-Else Statement": {
    "prefix": "ifelse",
    "body": ["if ${1:condition} {", "\t$0", "} else {", "\t", "}"],
    "description": "If-else statement"
  },
  "While Loop": {
    "prefix": "while",
    "body": ["while ${1:condition} {", "\t$0", "}"],
    "description": "While loop"
  },
  "For Loop": {
    "prefix": "for",
    "body": ["for ${1:i} in ${2:collection} {", "\t$0", "}"],
    "description": "For loop"
  },
  "Const Declaration": {
    "prefix": "const",
    "body": ["const ${1:name}: ${2:Type} = ${3:value};"],
    "description": "Declare a constant"
  },
  "Let Declaration": {
    "prefix": "let",
    "body": ["let ${1:name}: ${2:Type} = ${3:value};"],
    "description": "Declare a mutable variable"
  },
  "Match Expression": {
    "prefix": "match",
    "body": ["match ${1:expression} {", "\t${2:pattern} => $0,", "}"],
    "description": "Match expression"
  },
  "Try-Catch": {
    "prefix": "try",
    "body": ["try {", "\t$0", "} catch (${1:error}) {", "\t", "}"],
    "description": "Try-catch block"
  },
  "Type Definition": {
    "prefix": "type",
    "body": ["type ${1:TypeName} = ${2:definition};"],
    "description": "Define a type alias"
  },
  "Interface Definition": {
    "prefix": "interface",
    "body": ["interface ${1:InterfaceName} {", "\t${2:field}: ${3:Type};", "\t$0", "}"],
    "description": "Define an interface"
  },
  "Class Definition": {
    "prefix": "class",
    "body": ["class ${1:ClassName} {", "\tconstructor(${2:params}) {", "\t\t$0", "\t}", "}"],
    "description": "Define a class"
  },
  "Array Literal": {
    "prefix": "arr",
    "body": ["[${1:element1}, ${2:element2}]"],
    "description": "Array literal"
  },
  "Object Literal": {
    "prefix": "obj",
    "body": ["{", "\t${1:key}: ${2:value},", "\t$0", "}"],
    "description": "Object literal"
  },
  "Console Log": {
    "prefix": "log",
    "body": ["console.log(${1:value});"],
    "description": "Console log statement"
  }
}
