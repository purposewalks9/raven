{
  "name": "raven-language",
  "displayName": "Raven Language",
  "description": "Diagnostics, hover, go to definition, and find references for Raven.",
  "version": "0.0.1",
  "private": true,
  "publisher": "raven-lang",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:raven"],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "raven",
        "aliases": ["Raven", "raven"],
        "extensions": [".rv"],
        "configuration": "./language-configuration.json"
      }
    ]
  },
"scripts": {
    "build": "tsup src/extension.ts --format cjs --external vscode --clean",
    "dev": "tsup src/extension.ts --format cjs --external vscode --watch",
    "package": "vsce package"
},
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "typescript": "^5.5.4",
    "tsup": "^8.2.4"
  }
}
