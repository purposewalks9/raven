// demo.rv — a tour of what Raven can do right now

fn fibonacci(n: number): number
  if n < 2 then
    return n
  end
  return fibonacci(n - 1) + fibonacci(n - 2)
end

fn sumArray(values: array<number>): number
  let total = 0
  let i = 0
  while i < len(values) do
    total = total + values[i]
    i = i + 1
  end
  return total
end

const numbers: array<number> = [4, 8, 15, 16, 23, 42]

print("Fibonacci of 10 is:")
print(fibonacci(10))

print("Sum of array is:")
print(sumArray(numbers))

let greeting = "Hello, " + "Raven!"
print(greeting)

let hasManyItems = len(numbers) > 3
if hasManyItems and (sumArray(numbers) > 100) then
  print("Big array, big sum.")
else
  print("Not that big.")
end
