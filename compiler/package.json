{
  "name": "@raven/compiler",
  "version": "0.1.0",
  "type": "module",
  "description": "Raven — a statically typed language for the JavaScript ecosystem that compiles to optimized JS.",
  "keywords": ["compiler", "language", "typescript", "programming-language", "raven"],
  "homepage": "https://github.com/purposewalks9/raven",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/purposewalks9/raven.git",
    "directory": "compiler"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "raven": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli/index.ts --format esm --dts --clean",
    "dev": "tsup src/cli/index.ts --format esm --watch --onSuccess \"node dist/cli/index.js\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "eslint": "^9.8.0"
  }
}
