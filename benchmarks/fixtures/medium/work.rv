  return s + "!"
end

let excited = appendExclaim("hello")
let shout = appendExclaim(excited)

fn triple(x: number): number
  return x * 3
end

fn quadruple(x: number): number
  return x * 4
end

fn add(a: number, b: number): number
  return a + b
end

fn subtract(a: number, b: number): number
  return a - b
end

fn multiply(a: number, b: number): number
  return a * b
end

fn divide(a: number, b: number): number
  return a / b
end

let sum = add(4, 5)
let diff = subtract(9, 3)
let prod = multiply(3, 4)
let quot = divide(10, 2)

fn compute(a: number, b: number, op: string): number
  if op == "add" then
    return a + b
  end
  if op == "sub" then
    return a - b
  end
  if op == "mul" then
    return a * b
  end
  if op == "div" then
    return a / b
  end
  return 0
end

let result = compute(12, 4, "add")

model config = { env: "prod", debug: false, level: 3 }

fn logAt(level: number, message: string): number
  if level <= config.level then
    print(message)
  end
  return level
end

let log1 = logAt(1, "info")

fn evenUpTo(n: number): array<number>
  let out: array<number> = []
  let i = 0
  while i <= n do
    if i % 2 == 0 then
      out = out + [i]
    end
    i = i + 1
  end
  return out
end

let evens = evenUpTo(20)

fn primesUpTo(n: number): array<number>
  let out: array<number> = []
  let i = 2
  while i <= n do
    let isPrime = true
    let j = 2
    while j * j <= i do
      if i % j == 0 then
        isPrime = false
      end
      j = j + 1
    end
    if isPrime then
      out = out + [i]
    end
    i = i + 1
  end
  return out
end

let primes = primesUpTo(100)

fn gcd(a: number, b: number): number
  while b != 0 do
    let temp = b
    b = a % b
    a = temp
  end
  return a
end

let g = gcd(24, 36)

fn fibonacciList(n: number): array<number>
  let out: array<number> = [0, 1]
  let i = 2
  while i < n do
    out = out + [out[i - 1] + out[i - 2]]
    i = i + 1
  end
  return out
end

let fibs = fibonacciList(20)

model product = { id: 1, title: "Widget", price: 9.99, stock: 42 }

fn totalValue(items: array<number>): number
  let total = 0
  let i = 0
  while i < len(items) do
    total = total + items[i]
    i = i + 1
  end
  return total
end

let inventory = [5, 3, 8, 1, 9]
let value = totalValue(inventory)

fn discounted(price: number, percent: number): number
  return price - (price * percent) / 100
end

let sale = discounted(product.price, 20)

fn isPositive(n: number): boolean
  return n > 0
end

fn sign(n: number): string
  if n > 0 then
    return "+"
  end
  if n < 0 then
    return "-"
  end
  return "0"
end

let s1 = sign(5)
let s2 = sign(0 - 5)
let s3 = sign(0)

fn magnitude(n: number): number
  if n < 0 then
    return 0 - n
  end
  return n
end

let mag = magnitude(0 - 42)

fn countDigits(n: number): number
  let count = 1
  while n >= 10 do
    count = count + 1
    n = n / 10
  end
  return count
end

let digits = countDigits(123456)

print("benchmark medium complete")
